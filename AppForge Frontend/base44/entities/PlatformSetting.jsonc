{
  "name": "PlatformSetting",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Setting key (e.g. maintenance_mode, brand_name, default_currency)"
    },
    "value": {
      "type": "string",
      "description": "Setting value stored as string"
    },
    "category": {
      "type": "string",
      "default": "general",
      "enum": [
        "general",
        "build",
        "payment",
        "email",
        "theme"
      ]
    },
    "updated_by_email": {
      "type": "string"
    }
  },
  "required": [
    "key",
    "value"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}